// -----------------------------------------------------------------------------
// Artists in DSP - StereoWidenerDSPProcessor (Native Cmajor DSP Engine)
// -----------------------------------------------------------------------------

graph StereoWidenerDSPProcessor  [[ main ]]
{
    input stream float32<2> in;   // Synchroner Stereo-Audio-Eingang
    output stream float32<2> out; // Synchroner Stereo-Audio-Ausgang

    // Exakte Parameter-Zuordnungen laut Amorph v2 Preset Context Vorgabe
    input value float32 param1  [[ name: "Param 1", min: 0.0, max: 1.0, init: 0.5, step: 0.01 ]];
    input value float32 param2  [[ name: "Param 2", min: 20.0, max: 500.0, init: 100.0, step: 1.0 ]];
    input value float32 param3  [[ name: "Param 3", min: 0.0, max: 1.0, init: 0.0, step: 1.0 ]];
    input value float32 param4  [[ name: "Param 4", min: 0.0, max: 1.0, init: 1.0, step: 0.01 ]];

    // Signalfluss-Verknüpfungen mit dem inneren Worker-Processor
    node coreProcessor = StereoWidenerCoreEngine;

    connection
    {
        in -> coreProcessor.in;
        param1 -> coreProcessor.width;
        param2 -> coreProcessor.lowCut;
        param3 -> coreProcessor.monoCheck;
        param4 -> coreProcessor.inputGain;
        coreProcessor.out -> out;
    }
}

// Innerer Core-Processor mit Stream-Zuweisungsoperator (<-)
processor StereoWidenerCoreEngine
{
    input stream float32<2> in;
    output stream float32<2> out;

    input value float32 width;
    input value float32 lowCut;
    input value float32 monoCheck;
    input value float32 inputGain;

    // Filter-Zustand für Linkwitz-Riley Crossover (2-Pole Highpass)
    struct FilterState
    {
        float32 x1, x2, y1, y2;
    }
    
    FilterState hpL, hpR;

    // v4: 257-Tap Blackman-Hilbert FIR auf dem UNVERZÖGERTEN fullMid.
    // hilbBuf ist ein Shift-Register: hilbBuf[0] = aktuellstes fullMid,
    // hilbBuf[k] = fullMid von vor k Samples. Die FIR hat eine Gruppenlaufzeit
    // von M = 128 Samples; hY[n] referenziert damit fullMid[n-128] als Zentrum.
    float32[257] hilbBuf;

    // 128-Sample-Delay-Ringe (M = (257-1)/2): outMid, loSide und hiSide erhalten
    // exakt dieselbe Latenz wie die FIR-Gruppengröße. Dadurch referenzieren
    // outMid und genSide (= Hilbert von fullMid) dieselbe verzögerte Zeitbasis
    // und sind phasenexakt um 90° versetzt: E[outMid * genSide] = 0, die
    // L/R-Ausgänge sind bei jeder Breitungseinstellung pegelgleich.
    float32[128] midBuf;
    float32[128] loSBuf;
    float32[128] hiSBuf;
    wrap<128> di;

    // Antisymmetrische Hilbert-Koeffizienten (nur ungerade k = 1..127,
    // c_k = (2/(pi*k)) * Blackman-Fenster, 257 Taps). Damit:
    // hY = sum_i HILB_C[i] * (hilbBuf[129+2i] - hilbBuf[127-2i])
    // (identisch zur vollen 257-Tap-Faltung, da alle geraden Taps 0 sind)
    const float32[64] HILB_C = (
        0.636463777f, 0.211739011f, 0.126546001f, 0.089859367f, 0.069343659f, 0.056180677f, 0.046979267f, 0.040157274f,
        0.034877407f, 0.030655190f, 0.027190940f, 0.024289400f, 0.021817957f, 0.019683422f, 0.017818418f, 0.016173040f,
        0.014709545f, 0.013398862f, 0.012218233f, 0.011149584f, 0.010178366f, 0.009292728f, 0.008482902f, 0.007740753f,
        0.007059436f, 0.006433130f, 0.005856846f, 0.005326259f, 0.004837592f, 0.004387518f, 0.003973077f, 0.003591618f,
        0.003240749f, 0.002918295f, 0.002622265f, 0.002350824f, 0.002102276f, 0.001875042f, 0.001667646f, 0.001478707f,
        0.001306925f, 0.001151077f, 0.001010006f, 0.000882624f, 0.000767900f, 0.000664863f, 0.000572594f, 0.000490229f,
        0.000416954f, 0.000352007f, 0.000294673f, 0.000244286f, 0.000200226f, 0.000161921f, 0.000128843f, 0.000100510f,
        0.000076482f, 0.000056363f, 0.000039798f, 0.000026473f, 0.000016112f, 0.000008477f, 0.000003365f, 0.000000607f
    );

    void init()
    {
        hpL.x1 = 0.0f; hpL.x2 = 0.0f; hpL.y1 = 0.0f; hpL.y2 = 0.0f;
        hpR.x1 = 0.0f; hpR.x2 = 0.0f; hpR.y1 = 0.0f; hpR.y2 = 0.0f;
        hilbBuf[:] = 0.0f;
        midBuf[:] = 0.0f;
        loSBuf[:] = 0.0f;
        hiSBuf[:] = 0.0f;
    }

    void main()
    {
        loop
        {
            // 1. Eingangssignale über Indizes aus dem Stereo-Vektor extrahieren.
            //    Wichtig: Der ehemalige param4-Input-Gain wird hier absichtlich
            //    NICHT mehr angewendet. Amorph kann diesen, von der Custom-UI
            //    nicht bedienten Parameter beim Laden mit einem anderen Wert
            //    initialisieren, was zu einem unerwünschten Pegelverlust führt.
            //    Der Pfad bleibt damit bei 50 % Stereobreite exakt auf Unity.
            float32 inL = in[0];
            float32 inR = in[1];

            // 2. Koeffizienten für Frequenzweiche berechnen (Globaler Funktionsaufruf)
            float64 omega = 2.0 * float64(std::pi) * float64(lowCut) / processor.frequency;
            float64 kappa = tan(omega / 2.0);
            float64 a0 = 1.0 / (1.0 + sqrt(2.0) * kappa + kappa * kappa);
            
            float32 b0 = float32(a0);
            float32 b1 = float32(-2.0 * a0);
            float32 b2 = float32(a0);
            float32 a1 = float32(2.0 * a0 * (kappa * kappa - 1.0));
            float32 a2 = float32(a0 * (1.0 - sqrt(2.0) * kappa + kappa * kappa));

            // 3. Filter pro Kanal anwenden (Hochpass-Anteil isolieren)
            float32 hpOutL = (b0 * inL) + (b1 * hpL.x1) + (b2 * hpL.x2) - (a1 * hpL.y1) - (a2 * hpL.y2);
            hpL.x2 = hpL.x1; hpL.x1 = inL; hpL.y2 = hpL.y1; hpL.y1 = hpOutL;

            float32 hpOutR = (b0 * inR) + (b1 * hpR.x1) + (b2 * hpR.x2) - (a1 * hpR.y1) - (a2 * hpR.y2);
            hpR.x2 = hpR.x1; hpR.x1 = inR; hpR.y2 = hpR.y1; hpR.y1 = hpOutR;

            // Frequenzen unterhalb der Trennfrequenz abspalten
            float32 lowL = inL - hpOutL;
            float32 lowR = inR - hpOutR;

            // 4. Mid/Side je Band. Der Bass wird gesondert berechnet, damit er
            //    phasenstabil bleibt und bei 0 % mit dem Hochton zusammen nach
            //    mono fällt, während er oberhalb von 50 % geschützt bleibt.
            float32 loMid  = 0.5f * (lowL + lowR);
            float32 loSide = 0.5f * (lowL - lowR);
            float32 hiMid  = 0.5f * (hpOutL + hpOutR);
            float32 hiSide = 0.5f * (hpOutL - hpOutR);

            // 5. Breitungsgewinne: 0 % = mono (0), 50 % = Unity (1), 100 % = 2x.
            //    Der Bass wird mit demselben Faktor eingezogen, fällt aber
            //    oberhalb von 50 % nicht weiter auf (Bass-Schutz gegen
            //    Phasendrehungen und Pegelverlust im Tiefton).
            float32 hiGain = width * 2.0f;
            float32 loGain = hiGain;
            if (loGain > 1.0f)
                loGain = 1.0f;

            // 6. Mono-zu-Stereo (v4, Hilbert-Orthogonalität): Oberhalb von 50 %
            //    wird ein aus dem Gesamt-Mid abgeleitetes, mit einer 257-Tap
            //    Blackman-Hilbert-FIR um 90° phasengedrehtes Side-Signal
            //    addiert. Es wird symmetrisch auf L (+side) und R (-side)
            //    verteilt, sodass es bei einer Monosumme exakt herausfällt.
            //    Damit die L/R-Ausgänge bei jeder Breitungseinstellung
            //    pegelgleich bleiben, muss das Mid auf dem Ausgang (outMid)
            //    dieselbe Referenzzeit wie das Hilbert-Side haben: Beide
            //    beziehen sich auf fullMid[n-128] (M = 128 Samples = FIR-
            //    Gruppengröße). Phasendifferenz = exakt 90° ->
            //    E[outMid * genSide] = 0 -> L/R-PEGELGLEICH.
            //    Der Preis ist eine einheitliche, lineare Latenz von M = 128
            //    Samples (2.67 ms bei 48 kHz) auf ALLEN Ausgängen bei ALLEN
            //    Breitungswerten - DAW-kompensierbar. 50 % bleibt Unity:
            //    outL = inL[n-M], outR = inR[n-M].
            //    Unterhalb von 50 % ist extraWidth negativ - hier darf die
            //    synthetische Breitung aber NICHT aktiv sein, sonst ist 0 %
            //    nicht mehr voll mono. Deshalb auf 0 klemmen.
            float32 extraWidth = hiGain - 1.0f;   // -1 bei 0 %, 0 bei 50 %, 1 bei 100 %
            if (extraWidth < 0.0f)
                extraWidth = 0.0f;

            float32 fullMid = 0.5f * (inL + inR);

            // FIR-Shift-Register aktualisieren: hilbBuf[0] = aktuelles fullMid
            hilbBuf[1:257] = hilbBuf[0:256];
            hilbBuf[0] = fullMid;

            // Hilbert-Faltung (antisymmetrische 64-Koeffizienten-Form,
            // ungerade k = 1..127; alle geraden Taps sind exakt 0)
            float32 hY = 0.0f;
            for (int i = 0; i < 64; i++)
            {
                hY += HILB_C[i] * (hilbBuf[129 + (2 * i)] - hilbBuf[127 - (2 * i)]);
            }

            // 7. Mid und beide Seiten um M = 128 Samples verzögern (ein
            //    gemeinsamer Ring-Index), damit alle Komponenten auf der
            //    gleichen verzögerten Zeitbasis referenzieren.
            di++;
            float32 outMid  = midBuf[di];
            float32 loSideD = loSBuf[di];
            float32 hiSideD = hiSBuf[di];
            midBuf[di] = fullMid;
            loSBuf[di] = loSide;
            hiSBuf[di] = hiSide;

            // 8. Gesamt-Side je Band = originaler Side * Breitung + synthetische
            //    Mono-zu-Stereo-Breitung (Hilbert-orthogonal zum verzögerten Mid).
            float32 genSide = hY * extraWidth * 0.5f;
            float32 totalSide = loSideD * loGain + (hiSideD * hiGain + genSide);

            // 9. Zurück nach L/R dekodieren (vollständiges Signal, mono-kompatibel)
            float32 outL = outMid + totalSide;
            float32 outR = outMid - totalSide;

            // 10. Mono-Check Schalter einberechnen
            if (monoCheck > 0.5f)
            {
                float32 monoSum = 0.5f * (outL + outR);
                outL = monoSum;
                outR = monoSum;
            }

            // 11. Stream-Zuweisungsoperator (<-) für den Stereo-Ausgang
            out <- float32<2>(outL, outR);
            
            advance();
        }
    }
}
